# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# Server-only. Must NOT carry the NEXT_PUBLIC_ prefix, which would inline the
# credentials into the browser bundle.
# ---------------------------------------------------------------------------
NEON_DB_CONNECTION_STRING=

# ---------------------------------------------------------------------------
# Public origin of this app. Used to build the install snippet shown to users
# and to resolve analytics.js. Use http://localhost:3000 in development.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_HOST_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Clerk auth
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Slug of the Clerk billing plan that unlocks multiple websites.
CLERK_PRO_PLAN_SLUG=monthly

# ---------------------------------------------------------------------------
# Optional: have this app track itself. Add a website in the dashboard for
# your own domain and paste its website ID here. Leave blank to disable.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=
